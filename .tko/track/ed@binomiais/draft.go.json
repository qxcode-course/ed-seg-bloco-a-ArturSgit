            "label": "2026-05-20_11-43-01",
            "content": "package main\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n)\n\nfunc binomialcoeficient(n, k int) int {\n\n\tif k < 0 || k > n {\n\n\t\treturn 0\n\t}\n\tif k == 0 || k == n {\n\n\t\treturn 1\n\t}\n\tif k > n/2 {\n\t\tk = n - k\n\t}\n\n\tresult := 1\n\tfor i := 1; i <= k; i++ {\n\t\tresult = result * (n - k + i) / i\n\t}\n\n\treturn result\n}\n\nfunc main() {\n\n\tvar n, k int\n\t_, err := fmt.Scan(&n, &k)\n\tif err != nil {\n\t\tif err == io.EOF {\n\t\t\treturn\n\t\t}\n\t\tfmt.Fprintln(os.Stderr, \"Erro ao ler a entrada\", err)\n\t\treturn\n\t}\n\tfmt.Println(binomialcoeficient(n, k))\n}\n",
