            "label": "2026-06-05_17-55-03",
            "content": "package main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n)\n\nfunc Join(slice []int, sep string) string {\n\tif len(slice) == 0 {\n\t\treturn \"\"\n\t}\n\tresult := fmt.Sprintf(\"%d\", slice[0])\n\tfor _, value := range slice[1:] {\n\t\tresult += sep + fmt.Sprintf(\"%d\", value)\n\t}\n\treturn result\n}\n\ntype MultiSet struct {\n\tdata     []int\n\tsize     int\n\tcapacity int\n}\n\nfunc NewMultiSet(capacity int) *MultiSet {\n\n\tif capacity <= 0 {\n\t\tcapacity = 1\n\t}\n\n\treturn &MultiSet{\n\t\tdata:     make([]int, capacity),\n\t\tsize:     0,\n\t\tcapacity: capacity,\n\t}\n}\nfunc (ms *MultiSet) expand() {\n\n\tif ms.capacity == 0 {\n\t\tms.capacity = 1\n\n\t} else {\n\t\tms.capacity *= 2\n\t}\n\n\tnewData := make([]int, ms.capacity)\n\tcopy(newData, ms.data)\n\tms.data = newData\n}\n\nfunc (ms *MultiSet) search(value int) (bool, int) {\n\n\tlow := 0\n\thigh := ms.size - 1\n\tfoundIdx := -1\n\n\tfor low <= high {\n\n\t\tmid := low + (high-low)/2\n\n\t\tif ms.data[mid] == value {\n\n\t\t\tfoundIdx = mid\n\t\t\tlow = mid + 1\n\n\t\t} else if ms.data[mid] < value {\n\n\t\t\tlow = mid + 1\n\n\t\t} else {\n\n\t\t\thigh = mid - 1\n\n\t\t}\n\t}\n\n\tif foundIdx != -1 {\n\t\treturn true, foundIdx\n\t}\n\treturn false, low\n}\n\nfunc (ms *MultiSet) Insert(value int) {\n\n\tif ms.size >= ms.capacity {\n\t\tms.expand()\n\t}\n\n\t_, idx := ms.search(value)\n\tms.insert(value, idx)\n}\n\nfunc (ms *MultiSet) insert(value int, index int) {\n\n\tfor i := ms.size; i > index; i-- {\n\n\t\tms.data[i] = ms.data[i-1]\n\t}\n\n\tms.data[index] = value\n\tms.size++\n\treturn\n\n}\n\nfunc (ms *MultiSet) Erase(value int) error {\n\n\tfound, idx := ms.search(value)\n\tif !found {\n\t\treturn errors.New(\"value not found\")\n\t}\n\n\treturn ms.erase(idx)\n}\n\nfunc (ms *MultiSet) erase(index int) error {\n\n\tfor i := index; i < ms.size-1; i++ {\n\t\tms.data[i] = ms.data[i+1]\n\t}\n\tms.size--\n\treturn nil\n\n}\n\nfunc (ms *MultiSet) Contains(value int) bool {\n\n\tfound, _ := ms.search(value)\n\treturn found\n\n}\n\nfunc (ms *MultiSet) Count(value int) int {\n\n\tfound, idx := ms.search(value)\n\n\tif !found {\n\t\treturn 0\n\t}\n\tcount := 0\n\n\tfor i := idx; i >= 0 && ms.data[i] == value; i-- {\n\t\tcount++\n\n\t}\n\treturn count\n\n}\n\nfunc (ms *MultiSet) Unique() int {\n\n\tif ms.size == 0 {\n\t\treturn 0\n\t}\n\n\tuniqueCount := 1\n\n\tfor i := 1; i < ms.size; i++ {\n\t\tif ms.data[i] != ms.data[i-1] {\n\t\t\tuniqueCount++\n\t\t}\n\t}\n\treturn uniqueCount\n}\n\nfunc (ms *MultiSet) Clear() {\n\tms.size = 0\n}\n\nfunc (ms *MultiSet) String() string {\n\treturn \"[\" + Join(ms.data[:ms.size], \", \") + \"]\"\n}\n\nfunc main() {\n\tvar line, cmd string\n\tscanner := bufio.NewScanner(os.Stdin)\n\tvar ms *MultiSet\n\n\tfor scanner.Scan() {\n\t\tline = scanner.Text()\n\t\targs := strings.Fields(line)\n\t\tfmt.Printf(\"$%s\\n\", line)\n\t\tif len(args) == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tcmd = args[0]\n\n\t\tswitch cmd {\n\n\t\tcase \"end\":\n\n\t\t\treturn\n\n\t\tcase \"init\":\n\n\t\t\tvalue, _ := strconv.Atoi(args[1])\n\t\t\tms = NewMultiSet(value)\n\n\t\tcase \"insert\":\n\n\t\t\tif ms != nil {\n\t\t\t\tfor _, part := range args[1:] {\n\t\t\t\t\tvalue, _ := strconv.Atoi(part)\n\t\t\t\t\tms.Insert(value)\n\t\t\t\t}\n\t\t\t}\n\n\t\tcase \"show\":\n\n\t\t\tif ms != nil {\n\t\t\t\tfmt.Println(ms.String())\n\t\t\t}\n\n\t\tcase \"erase\":\n\n\t\t\tif ms != nil {\n\t\t\t\tvalue, _ := strconv.Atoi(args[1])\n\t\t\t\terr := ms.Erase(value)\n\t\t\t\tif err != nil {\n\t\t\t\t\tfmt.Println(err.Error())\n\t\t\t\t}\n\t\t\t}\n\n\t\tcase \"contains\":\n\n\t\t\tif ms != nil {\n\t\t\t\tvalue, _ := strconv.Atoi(args[1])\n\n\t\t\t\tif ms.Contains(value) {\n\t\t\t\t\tfmt.Println(\"true\")\n\t\t\t\t} else {\n\t\t\t\t\tfmt.Println(\"false\")\n\t\t\t\t}\n\t\t\t}\n\n\t\tcase \"count\":\n\n\t\t\tif ms != nil {\n\t\t\t\tvalue, _ := strconv.Atoi(args[1])\n\t\t\t\tfmt.Println(ms.Count(value))\n\t\t\t}\n\n\t\tcase \"unique\":\n\n\t\t\tif ms != nil {\n\t\t\t\tfmt.Println(ms.Unique())\n\t\t\t}\n\n\t\tcase \"clear\":\n\n\t\t\tif ms != nil {\n\t\t\t\tms.Clear()\n\t\t\t}\n\n\t\tdefault:\n\t\t\tfmt.Println(\"fail: comando invalido\")\n\t\t}\n\t}\n}\n",
